# Port the API listens on
PORT=4000

# Your own MongoDB connection string, e.g.
# mongodb://127.0.0.1:27017/todo-app  (local MongoDB)
# mongodb+srv://user:pass@cluster...  (Atlas)
# Leave empty to let the API start its own local MongoDB automatically.
MONGO_URI=

# Origin of the frontend that is allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:5173
